{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/shipping-fees.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/shipping-fees",
      "dest": "/api/shipping-fees.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
